load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "procobserver",
    srcs = [
        "client.go",
        "client_linux.go",
        "client_stub.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/procobserver",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/proctable",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "procobserver_test",
    srcs = [
        "client_linux_test.go",
        "client_test.go",
        "client_transport_integration_test.go",
        "observation_test.go",
        "observation_transport_integration_test.go",
        "testenv_import_test.go",
    ],
    data = ["//internal/runtime/observation:consumer_fixture"],
    embed = [":procobserver"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/observation",
        "//internal/testenv",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
