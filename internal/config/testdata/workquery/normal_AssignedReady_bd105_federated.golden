sh -c 'gc_read_assigned_batch() { set --; for gc_identity in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$gc_identity" ] && continue; set -- "$@" "--assignee-any=$gc_identity"; done; [ "$#" -gt 0 ] || { printf "[]"; return 0; }; gc ready "$@" --json --limit=0; }; gc_assigned_ready_all_json=$(gc_read_assigned_batch) || exit $?; for id in "$GC_SESSION_ID" "$GC_SESSION_NAME" "$GC_ALIAS"; do [ -z "$id" ] && continue; r=$(printf "%s" "$gc_assigned_ready_all_json" | jq --arg id "$id" '\''[.[] | select((.assignee // "") == $id)] | .[:1]'\'' 2>/dev/null); [ -n "$r" ] && [ "$r" != "[]" ] && printf "%s" "$r" && exit 0; done; printf "[]"'