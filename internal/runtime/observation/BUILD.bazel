load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "observation",
    srcs = ["observation.go", "status_sessions.go"],
    importpath = "github.com/gastownhall/gascity/internal/runtime/observation",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/proctable",
    ],
)

go_test(
    name = "observation_test",
    srcs = [
        "evidence_test.go",
        "observation_test.go",
        "status_sessions_test.go",
        "testenv_import_test.go",
    ],
    data = glob(["testdata/**"]),
    embed = [":observation"],
    deps = [
        "//internal/testenv",
        "//internal/runtime",
        "//internal/runtime/auto",
        "//internal/runtime/proctable",
    ],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(["**"], exclude = ["BUILD.bazel"], allow_empty = True),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "consumer_fixture",
    srcs = ["testdata/consumer-input.json"],
    visibility = ["//:__subpackages__"],
)
