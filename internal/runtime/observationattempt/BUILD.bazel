load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "observationattempt",
    srcs = ["attempt.go", "retention.go"],
    importpath = "github.com/gastownhall/gascity/internal/runtime/observationattempt",
    visibility = ["//:__subpackages__"],
)

go_test(
    name = "observationattempt_test",
    srcs = ["attempt_test.go", "retention_test.go"],
    embed = [":observationattempt"],
)

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(["**"], exclude = ["BUILD.bazel"]),
    visibility = ["//visibility:public"],
)
