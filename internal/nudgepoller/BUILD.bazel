load("@rules_go//go:def.bzl", "go_library", "go_test")

go_library(
    name = "nudgepoller",
    srcs = [
        "child_env.go",
        "poller.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/nudgepoller",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/execenv",
        "//internal/pathutil",
        "//internal/pidutil",
    ],
)

go_test(
    name = "nudgepoller_test",
    srcs = [
        "child_env_test.go",
        "poller_test.go",
        "testenv_import_test.go",
    ],
    embed = [":nudgepoller"],
    deps = ["//internal/testenv"],
)

# --- bazel_repo_srcs (managed by tools/bazel/repo_tree.py) ---

filegroup(
    name = "bazel_repo_srcs",
    srcs = glob(
        ["**"],
        allow_empty = True,
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)
