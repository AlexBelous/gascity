load("@rules_go//go:def.bzl", "go_library", "go_test")

# gazelle:build_tags integration

go_library(
    name = "procobserver",
    srcs = [
        "census.go",
        "census_v3.go",
        "census_v3_wire.go",
        "client.go",
        "client_linux.go",
        "client_stub.go",
        "client_v3.go",
    ],
    importpath = "github.com/gastownhall/gascity/internal/runtime/procobserver",
    visibility = ["//:__subpackages__"],
    deps = [
        "//internal/runtime",
        "//internal/runtime/proctable",
    ] + select({
        "@rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

